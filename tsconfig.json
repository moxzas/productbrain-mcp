{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "lib": [
      "es2022"
    ]
  },
  "include": [
    "src/**/*"
  ]
}